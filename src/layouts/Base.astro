---
import "../styles/global.css";
import { isEnglishEnabled } from "../lib/config";

interface Props {
  lang: "ja" | "en";
  title: string;
  description: string;
  path: string; // base-relative path of this page, e.g. "" or "en/"
}

const { lang, title, description, path } = Astro.props;
const enableEn = isEnglishEnabled();
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const abs = (p: string) =>
  Astro.site ? new URL(base + p, Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {abs(path) && <link rel="canonical" href={abs(path)} />}
    {
      enableEn && abs("") && (
        <link rel="alternate" hreflang="ja" href={abs("")} />
      )
    }
    {
      enableEn && abs("en/") && (
        <link rel="alternate" hreflang="en" href={abs("en/")} />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    {
      abs("avatar.jpg") && (
        <meta property="og:image" content={abs("avatar.jpg")} />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
